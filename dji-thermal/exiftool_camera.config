# Defines the XMP "Camera" namespace and its BandName tag for exiftool: ODM/ODX read the band name of an
# image from Camera:BandName, but exiftool does not know this namespace and cannot write undefined tags.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        Camera => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::Camera' },
        },
    },
);
%Image::ExifTool::UserDefined::Camera = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-Camera', 2 => 'Image' },
    NAMESPACE => { 'Camera' => 'http://pix4d.com/camera/1.0/' },
    WRITABLE => 'string',
    BandName => { },
);
1;
