# Defines two XMP namespaces for exiftool, which cannot write tags it does not define:
# - "Camera" and its BandName tag: ODM/ODX read the band name of an image from Camera:BandName.
# - "dtc", dji-thermal-cli's record of how a temperature image was measured, with the tag names the library's own
#   outputs use (urn:dji-thermal-cli:xmp:1.0).
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        Camera => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::Camera' },
        },
        dtc => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::dtc' },
        },
    },
);
%Image::ExifTool::UserDefined::Camera = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-Camera', 2 => 'Image' },
    NAMESPACE => { 'Camera' => 'http://pix4d.com/camera/1.0/' },
    WRITABLE => 'string',
    BandName => { },
);
%Image::ExifTool::UserDefined::dtc = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-dtc', 2 => 'Image' },
    NAMESPACE => { 'dtc' => 'urn:dji-thermal-cli:xmp:1.0' },
    WRITABLE => 'string',
    Software => { },
    Distance => { },
    DistanceSource => { },
    Humidity => { },
    Emissivity => { },
    ReflectedTemperatureC => { },
    AmbientTemperatureC => { },
);
1;
