{
  "name": "webodm-dji-thermal-dev",
  "description": "Host-only tests, lint and browser checks for the plugin in dji-thermal/ (not part of the plugin zip)",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "eslint"
  },
  "jest": {
    "roots": [
      "<rootDir>/dji-thermal/public"
    ],
    "testEnvironment": "jsdom",
    "passWithNoTests": true
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "10.0.1",
    "babel-jest": "30.5.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "playwright": "1.64.1"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ],
      "@babel/preset-react"
    ]
  }
}
